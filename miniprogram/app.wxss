/* ============================================================
   全局样式 · 暖象牙底 + 墨色 + 雾金
   小程序只能用系统字体：iOS 有「宋体 SC」效果最好；
   Android 多数机型会回退到黑体，属正常现象。
   ============================================================ */

page {
  background: #F6F3EE;
  color: #26241F;
  font-family: "Songti SC", "STSong", "Source Han Serif SC", "Noto Serif CJK SC", serif;
  font-size: 30rpx;
  line-height: 1.9;
  letter-spacing: 0.02em;
  -webkit-font-smoothing: antialiased;
}

view, text, image { box-sizing: border-box; }

/* ---------- 通用 ---------- */
.wrap      { padding-left: 48rpx; padding-right: 48rpx; }
.wrap--narrow { padding-left: 72rpx; padding-right: 72rpx; }
.center    { text-align: center; }
.pad       { padding-top: 130rpx; padding-bottom: 130rpx; }

.overline {
  font-size: 20rpx;
  letter-spacing: 0.44em;
  color: #A8875A;
  text-transform: uppercase;
  display: block;
}

.sec-title {
  font-size: 46rpx;
  font-weight: normal;
  letter-spacing: 0.22em;
  line-height: 1.6;
  margin-top: 26rpx;
  display: block;
}

/* — ◇ — 细线装饰 */
.orn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 36rpx;
  width: 340rpx;
  margin-left: auto;
  margin-right: auto;
}
.orn__line {
  height: 1px;
  flex: 1;
  background: #E2DACD;
}
.orn__dot {
  width: 11rpx;
  height: 11rpx;
  border: 1px solid #C6AC83;
  transform: rotate(45deg);
  margin: 0 22rpx;
  flex: none;
}

/* ---------- 出场动画 ---------- */
.reveal {
  opacity: 0;
  transform: translateY(40rpx);
  transition: opacity 1s cubic-bezier(.22,.68,.18,1), transform 1s cubic-bezier(.22,.68,.18,1);
}
.reveal.in { opacity: 1; transform: translateY(0); }
